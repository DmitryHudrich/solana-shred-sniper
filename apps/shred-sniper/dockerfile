FROM rust:1.97-trixie AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev libssl-dev pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef
WORKDIR /build

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY apps/shred-sniper/Cargo.toml apps/shred-sniper/Cargo.toml
RUN mkdir -p apps/shred-sniper/src \
    && echo 'fn main() {}' > apps/shred-sniper/src/main.rs
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY apps/shred-sniper apps/shred-sniper
RUN cargo build --release --package shred-sniper

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/shred-sniper /usr/local/bin/shred-sniper
ENTRYPOINT ["/usr/local/bin/shred-sniper"]
